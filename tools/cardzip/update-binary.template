#!/sbin/sh
# Generated by tools/cardzip/make-cardzip.py.
# Skyward passes: $1 API version, $2 status fd, $3 package path.
OUTFD=$2
ZIP=$3
SLOT=$(getprop ro.boot.slot_suffix)
[ -n "$SLOT" ] || SLOT=_a
say() { echo "ui_print $*"; echo "ui_print"; }
set -e

[ -n "$ZIP" ] && [ -e "$ZIP" ] || { say "package path missing"; exit 1; }
say "Card flash: @DESCRIPTION@"
say "Slot $SLOT. Do not unplug until Done."
LOGICAL="@LOGICAL@"
PHYSICAL="@PHYSICAL@"
AVB=@AVB@

if [ -n "$LOGICAL" ]; then
    for p in $LOGICAL; do
        say "Partition $p"
        dev="/dev/block/mapper/${p}${SLOT}"
        [ -e "$dev" ] || { say "missing $dev"; exit 1; }
        case "$p" in
@SIZES@
            *) say "no size for $p"; exit 1 ;;
        esac
        target=$(blockdev --getsize64 "$dev")
        [ "$size" -le "$target" ] || { say "$p image $size > partition $target"; exit 1; }
        say "Flashing $p ($size/$target bytes)"
        # Redirect, never unzip | dd: this recovery's dd aborts after a large
        # pipe copy, and the empty file would leave the partition half written.
        unzip -p "$ZIP" "images/$p.img" > "$dev"
        sync
        say "Wrote $p"
    done
fi

if [ -n "$PHYSICAL" ]; then
    for p in $PHYSICAL; do
        say "Partition $p"
        dev="/dev/block/by-name/${p}${SLOT}"
        [ -e "$dev" ] || { say "missing $dev"; exit 1; }
        case "$p" in
@PSIZES@
            *) say "no size for $p"; exit 1 ;;
        esac
        target=$(blockdev --getsize64 "$dev")
        [ "$size" -le "$target" ] || { say "$p image $size > partition $target"; exit 1; }
        say "Flashing $p ($size/$target bytes)"
        unzip -p "$ZIP" "images/$p.img" > "$dev"
        sync
        say "Wrote $p"
    done
fi

if [ "$AVB" = 1 ]; then
    say "Disabling AVB verification and verity"
    avbctl --force disable-verity
    avbctl --force disable-verification
    sync
fi

say "Done. Reboot to system."
exit 0
